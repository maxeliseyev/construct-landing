{
  "version": "1.0",
  "protocol": "grpc",
  "server": {
    "domain": "ams.konstruct.cc",
    "version": "0.9.12"
  },
  "grpc_endpoint": "ams.konstruct.cc:443",
  "services": [
    "auth.AuthService",
    "user.UserService",
    "messaging.MessagingService",
    "notification.NotificationService",
    "invite.InviteService",
    "media.MediaService"
  ],
  "ice": {
    "primary": "ice.ams.konstruct.cc:443",
    "relays": [
      "ice.msk.konstruct.cc:9443"
    ]
  },
  "capabilities": {
    "max_message_size_bytes": 65536,
    "max_file_size_bytes": 104857600,
    "supports_streaming": true,
    "supports_grpc_web": true,
    "supports_pq_crypto": true
  },
  "limits": {
    "max_message_size_bytes": 65536,
    "max_media_size_bytes": 104857600,
    "rate_limit_messages_per_hour": 1000
  }
}
